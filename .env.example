# Copy to .env and adjust. Every value has a sensible default.

# ---- Ollama --------------------------------------------------------------
# Running in Docker? Use http://host.docker.internal:11434 to reach the Ollama
# on your own machine, which is what gives you GPU acceleration on macOS.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# 8192 lets the model write a full explanation. Drop to 4096 on a machine with
# 8 GB of memory if you are also building the index at the same time.
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1500

# ---- Apache Tika ---------------------------------------------------------
TIKA_URL=http://localhost:9998

# ---- Stores --------------------------------------------------------------
CHROMA_PATH=index/chroma
COLLECTION=legal_docs_ollama
GRAPH_PATH=index/graph/graph.json
BM25_PATH=index/bm25/bm25.pkl

# ---- Retrieval -----------------------------------------------------------
TOP_K=8
UPLOAD_TOP_K=15
HYBRID_SEARCH=1
GRAPH_ENABLED=1
GRAPH_DEPTH=2

# ---- Ingest --------------------------------------------------------------
DATA_DIRS=data
EMBED_BATCH=64

# ---- Behaviour -----------------------------------------------------------
# The off-topic filter is off by default: at 3B it misclassifies real legal
# questions. Set to 1 to re-enable.
ENABLE_GUARD=0

# ---- Server --------------------------------------------------------------
# Loopback only by default. Set 0.0.0.0 to expose on your network — only do
# that on a network you trust; there is no authentication.
HOST=127.0.0.1
PORT=5002
# The Werkzeug debugger runs arbitrary code. Never enable it on a reachable host.
FLASK_DEBUG=0
